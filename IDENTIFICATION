<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Accès sécurisé</title>

<style>
body {
  background-color: #0d0d0d;
  color: #00ffcc;
  font-family: Arial, sans-serif;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  margin: 0;
}

.container {
  text-align: center;
  background-color: #111;
  padding: 30px;
  border-radius: 10px;
  box-shadow: 0 0 20px #00ffcc33;
}

input {
  padding: 10px;
  margin: 10px;
  border-radius: 5px;
  border: none;
  width: 200px;
}

button {
  padding: 10px 20px;
  margin-top: 10px;
  border: none;
  border-radius: 5px;
  background-color: #00ffcc;
  color: black;
  cursor: pointer;
}

button:hover {
  background-color: #00ccaa;
}
</style>

</head>
<body>

<div class="container">
  <h2>Connexion</h2>

  <input type="text" id="user" placeholder="Identifiant"><br>

  <input type="password" id="pass" placeholder="Mot de passe">
  <br>

  <button onclick="togglePassword()">Afficher / Masquer</button><br>

  <button onclick="login()">Valider</button>

  <p id="result"></p>
</div>

<script>

// 🔐 IDENTIFIANTS + MOTS DE PASSE
const data = {
  "naneey_": "mdp1",
  "kolibri8680": "mdp2",
  "herstal": "mdp3",
  "k.g.f": "mdp4",
  "kayu.mp4": "mdp5",
  "lysias_31130": "mdp6",
  "h.e.s.t.i.a": "mdp7",
  "starkeeeey": "mdp8",
  "kussenspookje": "mdp9"
};

// 🧩 INDICES PERSONNALISÉS
const indices = {
  "naneey_": "Indice : C",
  "kolibri8680": "Indice : H",
  "herstal": "Indice : K",
  "k.g.f": "Indice : L",
  "kayu.mp4": "Indice : N",
  "lysias_31130": "Indice : R",
  "h.e.s.t.i.a": "Indice : S",
  "starkeeeey": "Indice : ?",
  "kussenspookje": "Indice : 🔍"
};

// 👁️ AFFICHER / MASQUER MOT DE PASSE
function togglePassword() {
  let passField = document.getElementById("pass");
  if (passField.type === "password") {
    passField.type = "text";
  } else {
    passField.type = "password";
  }
}

// 🔓 LOGIN
function login() {
  let user = document.getElementById("user").value;
  let pass = document.getElementById("pass").value;

  if (data[user] && data[user] === pass) {
    document.getElementById("result").innerHTML = indices[user];
  } else {
    document.getElementById("result").innerHTML = "Accès refusé.";
  }
}

</script>

</body>
</html>
