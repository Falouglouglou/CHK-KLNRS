<!DOCTYPE html>
<html>
<head>
  <title>Accès sécurisé</title>
</head>
<body>

<h2>Connexion</h2>

<input type="text" id="user" placeholder="Identifiant"><br><br>
<input type="password" id="pass" placeholder="Mot de passe"><br><br>

<button onclick="login()">Valider</button>

<p id="result"></p>

<script>
const data = {
  "cassy": "gojo",
  "bob": "cacaboudin",
  "charlie": "secret3"
};

function login() {
  let user = document.getElementById("user").value.toLowerCase();
  let pass = document.getElementById("pass").value;

  if (data[user] && data[user] === pass) {
    document.getElementById("result").innerHTML =
      "Accès autorisé. Ton indice : " + user[0].toUpperCase();
  } else {
    document.getElementById("result").innerHTML = "Accès refusé.";
  }
}
</script>

</body>
</html>
